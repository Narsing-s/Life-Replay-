# Local development defaults. Never commit real secrets.
NODE_ENV=development
PORT=4173
JWT_SECRET=replace-with-a-long-random-local-secret
DATA_DIR=./data
FRONTEND_URL=http://localhost:4173
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:4173

# Shared production database / multi-instance deployment.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lifereplay?sslmode=require
# REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Durable private object storage (AWS S3 / Cloudflare R2 / MinIO).
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=life-replay-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# R2_ENDPOINT=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Production email/password recovery.
# RESEND_API_KEY=
# EMAIL_FROM=Life Replay <noreply@example.com>

# AI / embeddings.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PROVIDER_TIMEOUT_MS=15000

# Google Photos / Calendar / Drive OAuth.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-api.example.com/api/v1/integrations/google/callback

# Media processing/security.
# FFMPEG_PATH=/usr/bin/ffmpeg
# CLAMAV_URL=http://clamav:3310
# MAX_UPLOAD_BYTES=104857600
# MAX_MEDIA_BYTES=262144000

# Secure token/cookie mode.
# USE_HTTPONLY_COOKIES=false
# TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL_DAYS=30

# Observability.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com
# LOG_LEVEL=info

# Backup workflow secrets are configured in GitHub Actions, not here:
# LIFEOS_PGHOST, LIFEOS_PGPORT, LIFEOS_PGUSER, LIFEOS_PGPASSWORD, LIFEOS_PGDATABASE
# LIFEOS_BACKUP_BUCKET, LIFEOS_BACKUP_ENDPOINT, LIFEOS_BACKUP_ACCESS_KEY_ID, LIFEOS_BACKUP_SECRET_ACCESS_KEY
# LIFEOS_BACKUP_PASSPHRASE
