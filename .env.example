# Local development defaults. Never commit real secrets.
NODE_ENV=development
PORT=4173
JWT_SECRET=replace-with-a-long-random-local-secret
DATA_DIR=./data
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:4173

# Production example values (set in the deployment platform, not in Git):
# NODE_ENV=production
# DATA_DIR=/data/life-replay
# ALLOWED_ORIGINS=https://narsing-s.github.io
# MAX_UPLOAD_BYTES=104857600
# MAX_MEDIA_BYTES=262144000
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# GOOGLE_CLIENT_SECRET=
