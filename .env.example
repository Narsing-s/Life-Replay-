# Local development defaults. Never commit real secrets.
NODE_ENV=development
PORT=4173
JWT_SECRET=replace-with-a-long-random-local-secret
DATA_DIR=./data
GOOGLE_CLIENT_ID=
ALLOWED_ORIGINS=http://localhost:4173

# Production database/storage. These are required for multi-instance durable deployment.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lifereplay
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=auto
# S3_BUCKET=life-replay-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# REDIS_URL=redis://USER:PASSWORD@HOST:6379

# Production email/password recovery.
# RESEND_API_KEY=
# EMAIL_FROM=Life Replay <noreply@example.com>

# Production AI/embeddings (optional until enabled).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Photos OAuth.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-api.example.com/api/v1/integrations/google/callback

# Media processing/security services.
# FFMPEG_PATH=/usr/bin/ffmpeg
# CLAMAV_URL=http://clamav:3310

# Observability.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otel.example.com

# Existing upload limits.
# MAX_UPLOAD_BYTES=104857600
# MAX_MEDIA_BYTES=262144000
