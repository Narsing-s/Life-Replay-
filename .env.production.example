NODE_ENV=production
PORT=4173
FRONTEND_URL=https://your-frontend.example
ALLOWED_ORIGINS=https://your-frontend.example
JWT_SECRET=generate-a-random-32-plus-character-secret
TOKEN_ENCRYPTION_KEY=generate-a-random-32-plus-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/lifereplay
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true
PG_POOL_MAX=20

# Redis / BullMQ
REDIS_URL=rediss://user:password@host:6379

# S3-compatible object storage (AWS S3, Cloudflare R2, MinIO, etc.)
S3_ENDPOINT=https://storage.example
S3_REGION=auto
S3_BUCKET=life-replay
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=false

# Optional email
RESEND_API_KEY=
EMAIL_FROM=

# Optional AI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional Google Photos import
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-api.example/api/v1/integrations/google/callback
GOOGLE_OAUTH_SCOPE=https://www.googleapis.com/auth/photoslibrary.readonly

# Optional media security/processing
CLAMAV_URL=
FFMPEG_PATH=ffmpeg
MAX_MEDIA_BYTES=262144000

# Optional backup off-site copy
BACKUP_OFFSITE=false
BACKUP_RETENTION_COUNT=14

# Optional observability
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_TOKEN=
